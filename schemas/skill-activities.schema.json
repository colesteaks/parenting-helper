{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "bands",
    "grades",
    "activities"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "bands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "min_months",
          "max_months"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "min_months": {
            "type": "integer",
            "minimum": 0
          },
          "max_months": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "grades": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "activities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "area",
          "band",
          "title",
          "goal",
          "do",
          "easier",
          "harder",
          "materials",
          "minutes",
          "cadence",
          "evidence",
          "grade",
          "why",
          "notice",
          "safety"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)+$"
          },
          "area": {
            "type": "string",
            "minLength": 1
          },
          "band": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "goal": {
            "type": "string",
            "minLength": 1
          },
          "do": {
            "type": "string",
            "minLength": 1
          },
          "easier": {
            "type": "string",
            "minLength": 1
          },
          "harder": {
            "type": "string",
            "minLength": 1
          },
          "materials": {
            "type": "string",
            "minLength": 1
          },
          "minutes": {
            "type": "integer",
            "minimum": 1
          },
          "cadence": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "grade": {
            "type": "string",
            "minLength": 1
          },
          "why": {
            "type": "string",
            "minLength": 1
          },
          "notice": {
            "type": "string",
            "minLength": 1
          },
          "safety": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
