{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "version",
    "activities"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "activities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "domain",
          "routine",
          "interest_tags",
          "duration_minutes",
          "prep_minutes",
          "materials",
          "safety",
          "attribution",
          "variants"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "domain": {
            "type": "string",
            "minLength": 1
          },
          "routine": {
            "type": "string",
            "minLength": 1
          },
          "materials": {
            "type": "string",
            "minLength": 1
          },
          "safety": {
            "type": "string",
            "minLength": 1
          },
          "attribution": {
            "type": "string",
            "minLength": 1
          },
          "interest_tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "duration_minutes": {
            "type": "integer",
            "minimum": 1
          },
          "prep_minutes": {
            "type": "integer",
            "minimum": 0
          },
          "variants": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "min_months",
                "max_months",
                "instructions",
                "source_ids"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "min_months": {
                  "type": "integer",
                  "minimum": 0
                },
                "max_months": {
                  "type": "integer",
                  "minimum": 0
                },
                "instructions": {
                  "type": "string",
                  "minLength": 1
                },
                "source_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1,
                  "uniqueItems": true
                }
              }
            }
          }
        }
      }
    }
  }
}
